    "corpus": "node src/cli.js corpus",
    "stats": "node src/cli.js stats",
    "test": "node --test tests/config.test.js tests/view.test.js tests/video.test.js tests/theme.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "@resvg/resvg-js": "^2.6.2",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "aws-icons": "^3.3.0",
    "echarts": "^6.1.0",
    "markdown-it": "^15.0.2",
    "shiki": "^4.5.0",
    "textlint": "^15.8.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "yaml": "^2.9.1"
  }
